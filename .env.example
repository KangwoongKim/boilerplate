# ============================================================
# Boilerplate — 환경 변수 (이 파일만 수정)
# cp .env.example .env 후 값 입력
# ============================================================

# --- 앱 식별 (Docker 컨테이너명 · 프로젝트명에 사용) ---
APP_SLUG=boilerplate
APP_NAME=Boilerplate API

# --- PostgreSQL ---
POSTGRES_USER=boilerplate_user
POSTGRES_PASSWORD=boilerplate_password
POSTGRES_DB=boilerplate_db
POSTGRES_PORT=5432
# 로컬 uvicorn: localhost / Docker api 컨테이너: compose가 postgres 로 덮어씀
DATABASE_HOST=localhost

# --- API ---
API_PORT=8000
CORS_ORIGINS=["*"]
